# xd-build-admin origin (no trailing slash).
# Local: admin usually http://localhost:3000 (marketing site may use 3001 if 3000 is taken).
# Production: https://xd-build-admin.vercel.app

# Preferred on Vercel — read at runtime in Server Components (no rebuild after env change).
CMS_API_BASE_URL=

# Required for client-side contact form POST (browser → admin API). Set to the same admin origin.
# Server Components can use CMS_API_BASE_URL alone; contact submit needs this in the client bundle.
NEXT_PUBLIC_API_BASE_URL=
